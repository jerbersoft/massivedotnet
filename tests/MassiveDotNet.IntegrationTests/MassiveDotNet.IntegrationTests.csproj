<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>MassiveDotNet.IntegrationTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      These tests call the live Massive API and require a key. They are committed so the SDK can be
      exercised against the real service, but CI never runs them: see constitution rule 13. The
      project is deliberately kept in the solution so that it still COMPILES in CI, which is what
      catches public API drift.
    -->
    <RequiresLiveCredentials>true</RequiresLiveCredentials>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The deprecated tick endpoints are exercised here on purpose (constitution rule 2): the SDK
      ships them marked Obsolete, and a test has to call them to prove that. The suppression is
      scoped to this project; nothing is ever suppressed inside generated code (D18).
    -->
    <NoWarn>$(NoWarn);MASSIVE0002;MASSIVE0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MassiveDotNet.Rest/MassiveDotNet.Rest.csproj" />
    <ProjectReference Include="../../src/MassiveDotNet.WebSocket/MassiveDotNet.WebSocket.csproj" />
  </ItemGroup>

</Project>
