<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      AllocationTests asserts byte counts, and tiered compilation makes them vary between runs of
      the same binary: measured across four processes, 50,000-row deserialization reported either
      38,737,296 or 36,473,232 bytes depending on which tier the measured call happened to run at.
      Full optimization from the first call removes the variance, and it is also the right tier to
      gate on: it is the steady state a long-lived client reaches, where a tier-0 figure is not.
      The cost is roughly 0.35s on this project's ~1.6s run.
    -->
    <TieredCompilation>false</TieredCompilation>
    <OutputType>Exe</OutputType>
    <RootNamespace>MassiveDotNet.Rest.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      The deprecated tick endpoints are exercised here on purpose (constitution rule 2): the SDK
      ships them marked Obsolete, and a test has to call them to prove that. The suppression is
      scoped to this project; nothing is ever suppressed inside generated code (D18).
    -->
    <NoWarn>$(NoWarn);MASSIVE0002;MASSIVE0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!--
      TemporalTypeTests reflects over every shipped assembly, and the DI package is the third.
      Rule 8 confines Microsoft.Extensions.* to that package within src/, which this test project
      is not; CI greps src/ for exactly that reason.
    -->
    <ProjectReference Include="../../src/MassiveDotNet.Extensions.DependencyInjection/MassiveDotNet.Extensions.DependencyInjection.csproj" />
    <ProjectReference Include="../../src/MassiveDotNet.Rest/MassiveDotNet.Rest.csproj" />
    <ProjectReference Include="../../src/MassiveDotNet.WebSocket/MassiveDotNet.WebSocket.csproj" />
  </ItemGroup>

</Project>
