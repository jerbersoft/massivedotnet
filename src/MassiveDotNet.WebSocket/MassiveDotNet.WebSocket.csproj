<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MassiveDotNet.WebSocket</RootNamespace>
    <PackageId>MassiveDotNet.WebSocket</PackageId>
    <Description>WebSocket streaming client for the Massive (formerly Polygon.io) market data platform: real-time trades, quotes, and aggregates over the platform's feed hosts.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Core only. ClientWebSocket and System.Threading.Channels are both in-box on net10.0,
         so this package adds nothing to a consumer's restore graph (rules 7 and 8). -->
    <ProjectReference Include="../MassiveDotNet/MassiveDotNet.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TickerPool and the rest of Internal/ are internal; the tests need to construct them
         directly, the same reasoning MassiveDotNet.CodeGen already uses for its diagnostics. -->
    <InternalsVisibleTo Include="MassiveDotNet.WebSocket.Tests" />
    <!-- F3/H8 (Task 12 review round 1): LogStreamHealth is the only code in the SDK that formats
         stream state into log text, the only place an API key could reach a log (rule 11). The
         DI test project needs the internal MassiveStreamClient(options, clock) constructor and the
         internal MassiveWebSocketFactory-driven ConnectStocksAsync overload to build a connected
         MassiveStockStream offline, the same way MassiveDotNet.WebSocket.Tests already does. -->
    <InternalsVisibleTo Include="MassiveDotNet.Extensions.DependencyInjection.Tests" />
    <!-- L1 (Task 14 ruling): StockStreamTests' internal SubscribeRawAsync escape hatch, and
         MassiveStreamClient's internal ConnectRawAsync, are what let the live tier pin the
         entitlement message on markets #20 ships no facade for, and the silently-ignored-topic
         observation D33 exists to guard, without adding either as public API. -->
    <InternalsVisibleTo Include="MassiveDotNet.IntegrationTests" />
    <!-- L3 (Task 14 ruling): the AOT smoke test constructs StockTradeConverter and
         StockQuoteConverter directly to root the hand-written converters and the ConditionSet
         InlineArray, since an unreached generic instantiation is trimmed away and a clean publish
         would otherwise prove nothing about either. -->
    <InternalsVisibleTo Include="MassiveDotNet.AotSmokeTest" />
  </ItemGroup>

</Project>
