<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MassiveDotNet</RootNamespace>
    <PackageId>MassiveDotNet</PackageId>
    <Description>Core primitives shared by the MassiveDotNet SDK: transport, authentication, error handling, and allocation-conscious serialization helpers for the Massive (formerly Polygon.io) market data platform.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- The only two external dependencies permitted in core. See CLAUDE.md rule 7, D12, and D30.
         Both carry no transitive dependency on net10.0, so neither reaches a consumer's graph
         beyond itself, and both publish Native AOT clean (rules 3 and 4). -->
    <PackageReference Include="NodaTime" />
    <PackageReference Include="System.Threading.RateLimiting" />
  </ItemGroup>

</Project>
